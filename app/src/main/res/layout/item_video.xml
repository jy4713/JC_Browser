<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <!-- 썸네일 (poster > 페이지 스냅샷) -->
    <ImageView
        android:id="@+id/videoThumb"
        android:layout_width="72dp"
        android:layout_height="50dp"
        android:background="#ECEFF1"
        android:contentDescription="@string/item_preview"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtVideoKind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtVideoInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="#5F6368"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnPreview"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_btn_ripple"
        android:contentDescription="@string/item_preview"
        android:padding="8dp"
        android:src="@drawable/ic_play"
        android:tint="#1A73E8" />

    <Button
        android:id="@+id/btnDownload"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_btn_ripple"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/item_download"
        android:textAllCaps="false"
        android:textColor="@color/primary"
        android:textSize="12sp" />

    <ImageButton
        android:id="@+id/btnItemMenu"
        android:layout_width="34dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_btn_ripple"
        android:contentDescription="@string/menu_action"
        android:padding="7dp"
        android:src="@drawable/ic_menu_vert"
        android:tint="#5F6368" />
</LinearLayout>
