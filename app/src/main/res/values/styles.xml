<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- forceDark(어두운 모드)가 WebView에 적용되도록 허용 -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed">true</item>
        <item name="android:colorPrimary">#1A73E8</item>
        <item name="android:colorPrimaryDark">#1450A0</item>
        <item name="android:colorAccent">#1A73E8</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
    </style>
    <!-- 다크 테마 (설정에서 Dark 선택 시) -->
    <style name="AppTheme.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#1A73E8</item>
        <item name="android:colorPrimaryDark">#17181A</item>
        <item name="android:colorAccent">#8AB4F8</item>
        <item name="android:navigationBarColor">#17181A</item>
        <item name="android:windowBackground">#17181A</item>
    </style>
</resources>
